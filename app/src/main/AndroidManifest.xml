<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para hablar con Gemini y con Google Sheets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para saber si hay conexion y decidir si la venta va a la cola (Tarea 8). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Avisos de cobro. Desde Android 13 hay que pedirselo ademas a la usuaria. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para volver a programar los avisos cuando se reinicia el celular. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Butterfly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Butterfly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".recordatorios.ReceptorDeRecordatorios"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
